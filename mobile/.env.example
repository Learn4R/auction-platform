# Base URL of the server API (the same backend client/ talks to).
#
# Must be prefixed EXPO_PUBLIC_ to be readable at runtime (see lib/api.ts) —
# that's Expo's convention for env vars that need to reach client code.
#
# "localhost" only reaches the dev server from an iOS simulator or the web
# build. From an Android emulator use http://10.0.2.2:3000 instead: to the
# emulator, "localhost" means the emulator itself, not your host machine.
# From Expo Go on a physical device, use your computer's LAN IP instead,
# e.g. http://192.168.1.23:3000 — the device isn't on the same loopback
# interface as your dev machine.
EXPO_PUBLIC_API_URL="http://localhost:3000"
