# Copy to .env.test and fill in. Used only by `npm test` — see tests/README.md
# for what this is for and how the test schema gets created.

# Same Supabase connection string as .env — DATABASE_SCHEMA below is what
# actually isolates test data, so this can safely be the same value.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
DATABASE_SCHEMA="test"

# Doesn't need to match .env's JWT_SECRET — tests mint their own tokens.
JWT_SECRET=""

# The verify-payment signature tests need the real Razorpay TEST key secret
# (Settings > API Keys, test mode) so their HMACs match what the route
# actually recomputes. The webhook tests need whatever secret the webhook
# route is configured to check against — can be any value in test, since
# nothing external calls it; it just needs to match between the test and
# RAZORPAY_WEBHOOK_SECRET here.
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
