generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  buyer
  seller
  admin
}

enum ItemStatus {
  draft
  pending
  approved
  rejected
}

enum AuctionStatus {
  upcoming
  live
  ended
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ShippingStatus {
  processing
  shipped
  inTransit
  delivered
}

enum NotificationType {
  outbid
  auction_won
  listing_approved
  listing_rejected
  auction_extended
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
  on_hold
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(buyer)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  items           Item[]         @relation("SellerItems")
  bids            Bid[]
  maxBids         MaxBid[]
  watchlist       Watchlist[]
  orders          Order[]        @relation("BuyerOrders")
  wonAuctions     Auction[]      @relation("AuctionWinner")
  adminActions    AdminAction[]
  notifications   Notification[]
  reviewsWritten  Review[]       @relation("ReviewsWritten")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  payouts         Payout[]       @relation("SellerPayouts")
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  items Item[]
}

model Item {
  id          String     @id @default(cuid())
  title       String
  description String
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  year        Int?
  material    String?
  condition   String?
  images      String[]
  sellerId    String
  seller      User       @relation("SellerItems", fields: [sellerId], references: [id])
  status      ItemStatus @default(draft)

  proposedStartingBid  Decimal?  @db.Decimal(10, 2)
  proposedBidIncrement Decimal?  @db.Decimal(10, 2)
  proposedStartTime    DateTime?
  proposedEndTime      DateTime?
  rejectionReason      String?

  auction       Auction?
  watchlist     Watchlist[]
  notifications Notification[]
}

model Auction {
  id           String        @id @default(cuid())
  itemId       String        @unique
  item         Item          @relation(fields: [itemId], references: [id])
  startingBid  Decimal       @db.Decimal(10, 2)
  currentBid   Decimal?      @db.Decimal(10, 2)
  bidIncrement Decimal       @db.Decimal(10, 2)
  startTime    DateTime
  endTime      DateTime
  status       AuctionStatus @default(upcoming)
  winnerId     String?
  winner       User?         @relation("AuctionWinner", fields: [winnerId], references: [id])

  bids          Bid[]
  maxBids       MaxBid[]
  order         Order?
  notifications Notification[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  isProxy   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MaxBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auctionId, userId])
}

model Watchlist {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  @@id([userId, itemId])
}

model Order {
  id                String         @id @default(cuid())
  auctionId         String         @unique
  auction           Auction        @relation(fields: [auctionId], references: [id])
  buyerId           String
  buyer             User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  winningBid        Decimal        @db.Decimal(10, 2)
  buyerPremium      Decimal        @db.Decimal(10, 2)
  totalAmount       Decimal        @db.Decimal(10, 2)
  paymentStatus     PaymentStatus  @default(pending)
  shippingStatus    ShippingStatus @default(processing)
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime       @default(now())

  review Review?
  payout Payout?
}

model PlatformSettings {
  id                      String   @id @default("singleton")
  buyerPremiumPercent     Decimal  @default(10) @db.Decimal(5, 2)
  sellerCommissionPercent Decimal  @default(10) @db.Decimal(5, 2)
  updatedAt               DateTime @updatedAt
}

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  target    String
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  itemId    String?
  item      Item?            @relation(fields: [itemId], references: [id])
  auctionId String?
  auction   Auction?         @relation(fields: [auctionId], references: [id])
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  sellerId   String
  seller     User     @relation("ReviewsReceived", fields: [sellerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([sellerId, createdAt])
}

model Payout {
  id               String       @id @default(cuid())
  sellerId         String
  seller           User         @relation("SellerPayouts", fields: [sellerId], references: [id])
  orderId          String       @unique
  order            Order        @relation(fields: [orderId], references: [id])
  grossAmount      Decimal      @db.Decimal(10, 2)
  commissionAmount Decimal      @db.Decimal(10, 2)
  netAmount        Decimal      @db.Decimal(10, 2)
  status           PayoutStatus @default(pending)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([sellerId, createdAt])
}
