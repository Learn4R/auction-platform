# PostgreSQL connection string (Supabase: use the session pooler host for
# IPv4 compatibility; URL-encode any special characters in the password).
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Secret used to sign JWTs. Generate with: openssl rand -hex 48
JWT_SECRET=""

# Razorpay test/live API keys (Settings > API Keys in the Razorpay dashboard).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Supabase project URL and service role key, used for uploading item photos
# to the "item-images" storage bucket. Project Settings > API in Supabase.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Origin the client is served from — used for the CORS allow-list and the
# Socket.io CORS config. Defaults to http://localhost:5173 if not set.
CLIENT_URL="https://your-client-domain.example.com"

# Port to listen on. Most hosting platforms (Render, Railway, etc.) inject
# this automatically — usually no need to set it yourself. Defaults to 3000.
PORT=3000
